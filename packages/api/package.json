{
  "name": "@bull-board/api",
  "version": "9.10.4",
  "description": "A Dashboard server API built on top of bull or bullmq.",
  "keywords": [
    "bull",
    "bullmq",
    "dashboard",
    "monitoring",
    "queue",
    "redis"
  ],
  "license": "MIT",
  "author": "felixmosh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Samandar02/bull-board.git",
    "directory": "packages/api"
  },
  "files": [
    "dist",
    "typings",
    "*Adapter.*"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./dist/*": "./dist/*",
    "./typings/*": "./typings/*.d.ts",
    "./bullMQAdapter": "./bullMQAdapter.js",
    "./bullMQProAdapter": "./bullMQProAdapter.js",
    "./bullAdapter": "./bullAdapter.js",
    "./baseAdapter": "./baseAdapter.d.ts",
    "./constants/statuses": "./dist/constants/statuses.js",
    "./constants/datastores": "./dist/constants/datastores.js",
    "./constants/jobsPerPage": "./dist/constants/jobsPerPage.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "yarn clean && yarn tsc",
    "clean": "node -e \"fs.rmSync('dist', {recursive: true, force: true})\""
  },
  "dependencies": {
    "redis-info": "^3.1.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/redis-info": "^3.0.3",
    "bull": "^4.16.5",
    "bullmq": "^5.81.5",
    "ioredis": "^6.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@bull-board/ui": "9.10.4",
    "bull": "^4.16.5",
    "bullmq": "^5.56.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "bull": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    }
  }
}
