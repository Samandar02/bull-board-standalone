{
  "name": "@bull-board/root",
  "version": "9.10.4",
  "private": true,
  "description": "Bull queue UI for inspecting jobs",
  "keywords": [
    "bull",
    "bullmq",
    "dashboard",
    "monitoring",
    "queue",
    "redis"
  ],
  "bugs": {
    "url": "https://github.com/Samandar02/bull-board-standalone/issues"
  },
  "license": "MIT",
  "author": "Samandar02",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Samandar02/bull-board-standalone.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A -t run build",
    "clean": "yarn workspaces foreach -A run clean",
    "start": "yarn workspace @bull-board/server start",
    "dev": "concurrently --names \"UI,SERVER\" -c \"bgBlue.bold,bgMagenta.bold\" \"corepack yarn dev:ui\" \"corepack yarn dev:server\"",
    "dev:docker": "docker compose -f docker-compose.redis.yml up -d",
    "dev:server": "yarn workspace @bull-board/server dev",
    "dev:ui": "yarn workspace @bull-board/ui run dev",
    "lint": "oxlint './packages/**/*.{ts,tsx}' . --fix",
    "lint:check": "oxlint './packages/**/*.{ts,tsx}' .",
    "format": "oxfmt './packages/**/*.{ts,tsx}'",
    "format:check": "oxfmt './packages/**/*.{ts,tsx}' --check"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "concurrently": "^10.0.5",
    "ioredis": "^6.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "packageManager": "yarn@4.17.0"
}
